rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /models/{orderId}/{fileName} {
      // Allow authenticated users to view/download models
      allow read: if request.auth != null;
      
      // Enforce authentication, 50MB file size limit, and STL/OBJ extensions
      allow write: if request.auth != null
                   && request.resource.size < 50 * 1024 * 1024
                   && (fileName.toLowerCase().endsWith('.stl') || fileName.toLowerCase().endsWith('.obj'));
    }
  }
}
